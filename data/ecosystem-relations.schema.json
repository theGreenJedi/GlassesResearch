{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GlassesResearch ecosystem relationships",
  "type": "object",
  "required": [
    "schema_version",
    "nodes",
    "relations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]+$"
          },
          "type": {
            "enum": [
              "model",
              "lineage",
              "manufacturer",
              "oem_odm",
              "operating_platform",
              "companion_app",
              "sdk_api",
              "firmware_family",
              "protocol_transport",
              "ai_service",
              "community_project"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "enum": [
              "current",
              "historical",
              "unresolved"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "type",
          "evidence",
          "provenance",
          "confidence",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "member_of",
              "rebrand_of",
              "manufactured_by",
              "uses_platform",
              "compatible_with",
              "requires_app",
              "exposes_sdk",
              "uses_protocol",
              "depends_on_service",
              "community_supports",
              "supersedes"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "claim"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "claim": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "oneOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "url"
                  ]
                }
              ]
            }
          },
          "provenance": {
            "enum": [
              "primary",
              "independent",
              "community",
              "hands_on",
              "mixed"
            ]
          },
          "confidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "status": {
            "enum": [
              "established",
              "inferred",
              "unresolved"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

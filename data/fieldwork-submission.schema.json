{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://glassesresearch.org/schema/fieldwork-submission-v1.json",
  "title": "GlassesResearch Fieldwork Submission v1",
  "type": "object",
  "required": ["schema_version", "submission_id", "submitted_at", "model", "access_basis", "attestation_hands_on", "completion_percent", "answers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "submission_id": {"type": "string", "pattern": "^GR-FW-[A-Z0-9-]+$"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object",
      "required": ["entered_name"],
      "additionalProperties": false,
      "properties": {
        "entered_name": {"type": "string", "maxLength": 180},
        "canonical_id": {"type": ["string", "null"], "pattern": "^GLS-[0-9]{4}$"},
        "retail_name": {"type": ["string", "null"], "maxLength": 180},
        "model_number": {"type": ["string", "null"], "maxLength": 160}
      }
    },
    "access_basis": {"enum": ["purchased", "borrowed", "review_sample", "employer_provided", "retailer_or_event_demo", "other"]},
    "device_fingerprint": {
      "type": ["string", "null"],
      "description": "One-way duplicate-detection value. Raw serial numbers are prohibited from persisted submissions.",
      "minLength": 32,
      "maxLength": 256
    },
    "attribution": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["anonymous", "pseudonym", "public_name"]},
        "display_name": {"type": ["string", "null"], "maxLength": 120},
        "profile_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "completion_percent": {"type": "number", "minimum": 50, "maximum": 100},
    "attestation_hands_on": {"const": true},
    "attestation_observation": {"type": ["boolean", "null"]},
    "answers": {
      "type": "object",
      "description": "Question-ID keyed answers. A serial number, raw or encoded, is forbidden here.",
      "propertyNames": {"not": {"pattern": "^(serial|serial_number|raw_serial)$"}},
      "additionalProperties": true
    },
    "evidence_links": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "maxItems": 50
    },
    "moderation": {
      "type": "object",
      "description": "Server-side research state; never inferred from completion score.",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["submitted", "accepted", "needs_clarification", "rejected", "withdrawn"]},
        "evidence_label": {"enum": ["community_reported", "independent_hands_on", "corroborated_community", "bench_candidate", "bench_confirmed", "not_reproduced", "resolved_by_update"]}
      }
    }
  },
  "not": {
    "anyOf": [
      {"required": ["serial"]},
      {"required": ["serial_number"]},
      {"required": ["raw_serial"]}
    ]
  }
}

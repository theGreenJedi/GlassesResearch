  "schema": {
    "record_key": "GLS stable identifier",
    "fields": {
      "state": "missing | candidate | cleared | published",
      "primary_image": "site-relative path to rights-cleared primary presentation image",
      "source_url": "source page for the asset",
      "credit": "creator or rights holder",
      "rights_basis": "documented publication basis: original-photography | licensed | manufacturer-press-media | manufacturer-editorial-use | open-license | public-domain; manufacturer-editorial-use also requires editorial_purpose. GlassesResearch redistribution",
      "retrieved_or_captured": "YYYY-MM-DD",
      "alt": "model-specific accessible description",
      "try_on_asset": "optional transparent front-facing asset suitable for face overlay",
      "asset_dimensions_mm": "optional calibrated physical frame dimensions",
      "try_on_scale": "Per-model overlay width multiplier relative to detected outer-eye distance; numeric, 1.0–4.0.",
      "try_on_y_offset": "Per-model vertical overlay offset in percentage points; numeric.",
      "try_on_rotation_offset": "Per-model rotation correction in degrees; numeric."
    }
  },
  "publication_gate": "A visual record may be state=published only when primary_image, source_url or original-photography provenance, credit, rights_basis, retrieval/capture date, and alt text are documented. try_on_asset additionally requires a model-specific transparent asset; visual try-on is not a fit measurement."
